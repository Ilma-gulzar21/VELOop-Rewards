# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
# IMPORTANT: redemptions/refunds use MongoDB multi-document TRANSACTIONS, which need a
# replica set. Use MongoDB Atlas (recommended, free tier works), e.g.
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/veloop_rewards
# A plain standalone local `mongod` will NOT work (run it as a single-node replica set instead).
MONGO_URI=

# JWT Configuration
JWT_SECRET=replace_with_your_user_jwt_secret
ADMIN_JWT_SECRET=replace_with_your_admin_jwt_secret

# Frontend Configuration
FRONTEND_URL=http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173

# Admin Seed Configuration
ADMIN_SEED_NAME=VELOop Super Admin
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# Optional Demo User Configuration
DEMO_USER_NAME=VELOop Demo User
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=

# Optional reward denominations (set only to officially CONFIRMED values).
# Preferred: copy seed/rewardOptions.verified.example.json -> seed/rewardOptions.verified.json,
# fill it with confirmed values, set "confirmed": true and run `npm run seed:data`.
SEED_UPI_REWARD_VALUE=
SEED_UPI_REQUIRED_VES=
SEED_AMAZON_REWARD_VALUE=
SEED_AMAZON_REQUIRED_VES=
SEED_GOOGLE_PLAY_REWARD_VALUE=
SEED_GOOGLE_PLAY_REQUIRED_VES=

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Required before creating new redemptions after payout-detail encryption is enabled.
PAYOUT_ENCRYPTION_KEY=replace_with_base64_encoded_32_byte_key


# ---- Demo / non-production only (used by `npm run seed:demo`) ----------------
# seed:demo refuses to run unless DEMO_MODE=true. Never enable on a production database.
DEMO_MODE=false
# Defaults are listed in docs/DEMO_ACCESS.md. Override here if you prefer other demo values.
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_LOWBAL_EMAIL=
DEMO_USER_BALANCE=15000

# Optional: raise API rate limits when running the integration tests only.
# REDEMPTION_CREATE_LIMIT=200
# REDEMPTION_QUOTE_LIMIT=200
