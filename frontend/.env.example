# Backend API base URL (include /api)
VITE_API_URL=http://localhost:5000/api

# ---- DEMO / NON-PRODUCTION ONLY -------------------------------------------
# Shows a "Demo credentials" panel on the login pages. MUST stay false/unset in production.
VITE_DEMO_MODE=false
# Demo accounts created by `DEMO_MODE=true npm run seed:demo` (backend).
# VITE_DEMO_ADMIN_EMAIL=demo.admin@veloop.demo
# VITE_DEMO_ADMIN_PASSWORD=DemoAdmin@2026
# VITE_DEMO_USER_EMAIL=demo.user@veloop.demo
# VITE_DEMO_USER_PASSWORD=DemoUser@2026
