{
  "info": {
    "name": "VELOop Rewards API",
    "description": "API collection for VELOop Rewards MERN application.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "userToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "rewardOptionId",
      "value": ""
    },
    {
      "key": "redemptionId",
      "value": ""
    },
    {
      "key": "methodId",
      "value": ""
    },
    {
      "key": "optionId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "User Signup",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Demo User\",\n  \"email\": \"demo@example.com\",\n  \"password\": \"Demo@12345\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/signup"
          }
        },
        {
          "name": "User Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo@example.com\",\n  \"password\": \"Demo@12345\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Get User Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/auth/me"
          }
        },
        {
          "name": "Admin Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ADMIN_EMAIL\",\n  \"password\": \"ADMIN_PASSWORD\"\n}"
            },
            "url": "{{baseUrl}}/api/admin/login"
          }
        },
        {
          "name": "Get Admin Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/admin/profile"
          }
        }
      ]
    },
    {
      "name": "User Wallet",
      "item": [
        {
          "name": "Get My Wallet",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/wallet"
          }
        },
        {
          "name": "Get My Transactions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/wallet/transactions?page=1&limit=10"
          }
        }
      ]
    },
    {
      "name": "Payout Methods",
      "item": [
        {
          "name": "Get Available Payout Methods",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/payouts/methods"
          }
        },
        {
          "name": "Get UPI Reward Options",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/payouts/options?method=upi"
          }
        },
        {
          "name": "Get Amazon Reward Options",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/payouts/options?method=amazon"
          }
        },
        {
          "name": "Get Google Play Reward Options",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/payouts/options?method=googlePlay"
          }
        }
      ]
    },
    {
      "name": "User Redemptions",
      "item": [
        {
          "name": "Get Redemption Quote",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rewardOptionId\": \"{{rewardOptionId}}\"\n}"
            },
            "url": "{{baseUrl}}/api/redemptions/quote"
          }
        },
        {
          "name": "Create UPI Redemption",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "redemption-test-001"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rewardOptionId\": \"{{rewardOptionId}}\",\n  \"upiId\": \"yourname@okaxis\"\n}"
            },
            "url": "{{baseUrl}}/api/redemptions"
          }
        },
        {
          "name": "Get My Redemptions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/redemptions/my"
          }
        },
        {
          "name": "Get My Redemption Details",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/redemptions/my/{{redemptionId}}"
          }
        }
      ]
    },
    {
      "name": "Admin Dashboard and Users",
      "item": [
        {
          "name": "Get Dashboard Stats",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/admin/dashboard/stats"
          }
        },
        {
          "name": "Get All Users",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/admin/users?page=1&limit=10"
          }
        },
        {
          "name": "Get User Details",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/admin/users/{{userId}}"
          }
        },
        {
          "name": "Get Admin Transactions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/admin/transactions?page=1&limit=10"
          }
        },
        {
          "name": "Credit User Wallet",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"amount\": 100,\n  \"description\": \"Demo wallet credit\",\n  \"idempotencyKey\": \"admin-credit-demo-001\"\n}"
            },
            "url": "{{baseUrl}}/api/admin/wallet/credit"
          }
        },
        {
          "name": "Debit User Wallet",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"amount\": 50,\n  \"description\": \"Demo wallet debit\",\n  \"idempotencyKey\": \"admin-debit-demo-001\"\n}"
            },
            "url": "{{baseUrl}}/api/admin/wallet/debit"
          }
        }
      ]
    },
    {
      "name": "Admin Payout Management",
      "item": [
        {
          "name": "Get Admin Payout Methods",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/admin/payouts/methods"
          }
        },
        {
          "name": "Get Admin Reward Options",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/admin/payouts/reward-options"
          }
        },
        {
          "name": "Update Payout Method",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"UPI Cash\",\n  \"isEnabled\": true\n}"
            },
            "url": "{{baseUrl}}/api/admin/payouts/methods/{{methodId}}"
          }
        },
        {
          "name": "Update Reward Option",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Updated reward description\",\n  \"isEnabled\": true\n}"
            },
            "url": "{{baseUrl}}/api/admin/payouts/reward-options/{{optionId}}"
          }
        }
      ]
    },
    {
      "name": "Admin Redemptions",
      "item": [
        {
          "name": "Get All Redemptions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/admin/redemptions?page=1&limit=10"
          }
        },
        {
          "name": "Get Redemption Details",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/admin/redemptions/{{redemptionId}}"
          }
        },
        {
          "name": "Update Redemption Status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"UNDER_REVIEW\",\n  \"adminNote\": \"Request is under review.\"\n}"
            },
            "url": "{{baseUrl}}/api/admin/redemptions/{{redemptionId}}/status"
          }
        },
        {
          "name": "Get Audit Logs",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/admin/audit-logs?page=1&limit=10"
          }
        }
      ]
    },
    {
      "name": "Admin Settings",
      "item": [
        {
          "name": "Public Payout Settings",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/payouts/settings"
          }
        },
        {
          "name": "Get Admin Settings",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/admin/settings"
          }
        },
        {
          "name": "Update Admin Settings",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"minRequiredVEs\": null,\n  \"maxRequiredVEs\": null,\n  \"maxRequestsPerDay\": null,\n  \"processingInstructions\": \"Requests are reviewed by the rewards team.\",\n  \"userFacingMessage\": \"\",\n  \"changeReason\": \"Initial development configuration\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/admin/settings"
          }
        }
      ]
    },
    {
      "name": "Additional lifecycle, filters and security (V5)",
      "item": [
        {
          "name": "Cancel pending redemption",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/redemptions/my/{{redemptionId}}/cancel"
          }
        },
        {
          "name": "Admin redemption list - search/date/sort",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/admin/redemptions?search={{userId}}&startDate=2026-11-01&endDate=2026-11-30&sortBy=createdAt&sortOrder=desc"
          }
        },
        {
          "name": "Admin transactions - search/date",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/admin/transactions?search={{userId}}&startDate=2026-11-01&endDate=2026-11-30"
          }
        },
        {
          "name": "Restrict payout access only",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/admin/users/{{userId}}/payout-restriction",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"restricted\": true,\n  \"reason\": \"Temporary payout review\"\n}"
            }
          }
        },
        {
          "name": "Restore payout access",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/admin/users/{{userId}}/payout-restriction",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"restricted\": false,\n  \"reason\": \"Review completed\"\n}"
            }
          }
        },
        {
          "name": "Dashboard stats date range",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/admin/dashboard/stats?startDate=2026-11-01&endDate=2026-11-30"
          }
        }
      ]
    }
  ]
}
